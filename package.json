{
  "name": "var-rag",
  "version": "0.0.0",
  "private": true,
  "description": "Football VAR Decision Explorer — retrieval-augmented football law and incident explorer",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "nx run-many -t dev serve --parallel=3",
    "dev:web": "nx dev web --port=3000",
    "dev:api": "nx serve api",
    "dev:worker": "nx serve worker",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis",
    "db:migrate": "nx build database && node libs/database/dist/lib/run-migrations.js",
    "db:migration:create": "pnpm --filter @var-rag/database exec prisma migrate dev --create-only --config prisma.config.ts",
    "db:migration:generate": "pnpm --filter @var-rag/database exec prisma migrate dev --config prisma.config.ts",
    "corpus:ingest": "nx build worker && node apps/worker/dist/main.js ingest",
    "corpus:inspect": "nx build worker && node apps/worker/dist/main.js inspect",
    "corpus:publish": "nx build worker && node apps/worker/dist/main.js publish",
    "corpus:retire": "nx build worker && node apps/worker/dist/main.js retire",
    "corpus:reindex": "nx build worker && node apps/worker/dist/main.js reindex",
    "eval:retrieval": "nx build worker && node apps/worker/dist/main.js eval --fake-embedder",
    "bench:ask": "nx build worker && node apps/worker/dist/main.js bench-ask",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "NODE_ENV=production nx run-many -t build"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "^23.1.1",
    "@nx/nest": "^23.1.1",
    "@nx/next": "^23.1.1",
    "@nx/node": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "babel-jest": "~30.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "prettier": "~3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
